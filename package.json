{
  "name": "@spacemutters/lattice",
  "version": "0.1.0",
  "description": "A spreadsheet formula engine: Pratt parser, dependency graph, and incremental recalculation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "tsx bench/recalc.bench.ts",
    "typecheck": "tsc --noEmit",
    "app:dev": "vite",
    "app:build": "vite build",
    "app:preview": "vite preview"
  },
  "keywords": [
    "spreadsheet",
    "formula",
    "parser",
    "pratt-parser",
    "dependency-graph",
    "incremental-computation",
    "excel"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
